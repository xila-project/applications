(import "wasi_snapshot_preview1" "fd_readdir" (func $fd_readdir (param i32 i32 i32 i64 i32) (result i32)))
(import "wasi_snapshot_preview1" "sched_yield" (func $sched_yield (param ) (result i32)))
(import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
  (memory (export "memory") 1)
  (data (i32.const 512) "a.txt\00\00\00d\00\00\00\00\00\00\00d/b.txt\00\00\00\00\00\00\00\00\00hello world")
  (func (export "fd_sync") (param i32) (result i32) local.get 0 call $fd_sync)
  (func (export "fd_datasync") (param i32) (result i32) local.get 0 call $fd_datasync)
  (func (export "fd_advise") (param i32 i64 i64 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 call $fd_advise)
  (func (export "fd_allocate") (param i32 i64 i64) (result i32) local.get 0 local.get 1 local.get 2 call $fd_allocate)
  (func (export "fd_filestat_set_size") (param i32 i64) (result i32) local.get 0 local.get 1 call $fd_filestat_set_size)
  (func (export "fd_filestat_set_times") (param i32 i64 i64 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 call $fd_filestat_set_times)
  (func (export "fd_tell") (param i32 i32) (result i32) local.get 0 local.get 1 call $fd_tell)
  (func (export "fd_fdstat_set_flags") (param i32 i32) (result i32) local.get 0 local.get 1 call $fd_fdstat_set_flags)
  (func (export "fd_fdstat_set_rights") (param i32 i64 i64) (result i32) local.get 0 local.get 1 local.get 2 call $fd_fdstat_set_rights)
  (func (export "fd_renumber") (param i32 i32) (result i32) local.get 0 local.get 1 call $fd_renumber)
  (func (export "fd_pread") (param i32 i32 i32 i64 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 local.get 4 call $fd_pread)
  (func (export "fd_pwrite") (param i32 i32 i32 i64 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 local.get 4 call $fd_pwrite)
  (func (export "proc_raise") (param i32) (result i32) local.get 0 call $proc_raise)
  (func (export "sock_accept") (param i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 call $sock_accept)
  (func (export "sock_recv") (param i32 i32 i32 i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 local.get 4 local.get 5 call $sock_recv)
  (func (export "sock_send") (param i32 i32 i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 local.get 4 call $sock_send)
  (func (export "sock_shutdown") (param i32 i32) (result i32) local.get 0 local.get 1 call $sock_shutdown)
  (func (export "poll_oneoff") (param i32 i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 call $poll_oneoff)
  (func (export "clock_res_get") (param i32 i32) (result i32) local.get 0 local.get 1 call $clock_res_get)
  (func (export "clock_time_get") (param i32 i64 i32) (result i32) local.get 0 local.get 1 local.get 2 call $clock_time_get)
  (func (export "fd_read") (param i32 i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 call $fd_read)
  (func (export "fd_write") (param i32 i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 call $fd_write)
  (func (export "fd_close") (param i32) (result i32) local.get 0 call $fd_close)
  (func (export "fd_seek") (param i32 i64 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 call $fd_seek)
  (func (export "fd_fdstat_get") (param i32 i32) (result i32) local.get 0 local.get 1 call $fd_fdstat_get)
  (func (export "fd_filestat_get") (param i32 i32) (result i32) local.get 0 local.get 1 call $fd_filestat_get)
  (func (export "fd_prestat_get") (param i32 i32) (result i32) local.get 0 local.get 1 call $fd_prestat_get)
  (func (export "fd_prestat_dir_name") (param i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 call $fd_prestat_dir_name)
  (func (export "path_remove_directory") (param i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 call $path_remove_directory)
  (func (export "path_filestat_set_times") (param i32 i32 i32 i32 i64 i64 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 local.get 4 local.get 5 local.get 6 call $path_filestat_set_times)
  (func (export "path_rename") (param i32 i32 i32 i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 local.get 4 local.get 5 call $path_rename)
  (func (export "path_link") (param i32 i32 i32 i32 i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 local.get 4 local.get 5 local.get 6 call $path_link)
  (func (export "path_create_directory") (param i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 call $path_create_directory)
  (func (export "path_symlink") (param i32 i32 i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 local.get 4 call $path_symlink)
  (func (export "path_readlink") (param i32 i32 i32 i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 local.get 4 local.get 5 call $path_readlink)
  (func (export "path_unlink_file") (param i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 call $path_unlink_file)
  (func (export "path_open") (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 local.get 4 local.get 5 local.get 6 local.get 7 local.get 8 call $path_open)
  (func (export "path_filestat_get") (param i32 i32 i32 i32 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 local.get 4 call $path_filestat_get)
  (func (export "args_get") (param i32 i32) (result i32) local.get 0 local.get 1 call $args_get)
  (func (export "args_sizes_get") (param i32 i32) (result i32) local.get 0 local.get 1 call $args_sizes_get)
  (func (export "environ_get") (param i32 i32) (result i32) local.get 0 local.get 1 call $environ_get)
  (func (export "environ_sizes_get") (param i32 i32) (result i32) local.get 0 local.get 1 call $environ_sizes_get)
  (func (export "random_get") (param i32 i32) (result i32) local.get 0 local.get 1 call $random_get)
  (func (export "fd_readdir") (param i32 i32 i32 i64 i32) (result i32) local.get 0 local.get 1 local.get 2 local.get 3 local.get 4 call $fd_readdir)
  (func (export "sched_yield")  (result i32)  call $sched_yield)
  (func (export "proc_exit") (param i32) local.get 0 call $proc_exit)

  (global $failed (mut i32) (i32.const 0))

  (func $check (param $actual i32) (param $expected i32) (param $step i32)
    (if (i32.and (i32.eqz (global.get $failed)) (i32.ne (local.get $actual) (local.get $expected)))
      (then (global.set $failed (local.get $step)))))

  ;; Layout: 512 "a.txt", 520 "d", 528 "d/b.txt", 544 "hello world",
  ;; 600 write iovec, 616 read iovec, 640 count, 648 descriptor, 656 offset,
  ;; 672 filestat, 700 read buffer.
  (func (export "scenario") (result i32)
    (local $fd i32)
    (i32.store (i32.const 600) (i32.const 544))
    (i32.store (i32.const 604) (i32.const 11))
    (i32.store (i32.const 616) (i32.const 700))
    (i32.store (i32.const 620) (i32.const 5))

    ;; 1: create a.txt for reading and writing.
    (call $check (call $path_open (i32.const 3) (i32.const 0) (i32.const 512) (i32.const 5)
        (i32.const 1) (i64.const 66) (i64.const 0) (i32.const 0) (i32.const 648)) (i32.const 0) (i32.const 1))
    (local.set $fd (i32.load (i32.const 648)))
    ;; 2-3: pwrite the whole text at offset 0.
    (call $check (call $fd_pwrite (local.get $fd) (i32.const 600) (i32.const 1) (i64.const 0) (i32.const 640)) (i32.const 0) (i32.const 2))
    (call $check (i32.load (i32.const 640)) (i32.const 11) (i32.const 3))
    ;; 4: pwrite did not move the cursor.
    (call $check (call $fd_tell (local.get $fd) (i32.const 656)) (i32.const 0) (i32.const 4))
    (call $check (i32.wrap_i64 (i64.load (i32.const 656))) (i32.const 0) (i32.const 5))
    ;; 6-8: pread "world" from offset 6; the cursor still has not moved.
    (call $check (call $fd_pread (local.get $fd) (i32.const 616) (i32.const 1) (i64.const 6) (i32.const 644)) (i32.const 0) (i32.const 6))
    (call $check (i32.load (i32.const 644)) (i32.const 5) (i32.const 7))
    (call $check (i32.load8_u (i32.const 700)) (i32.const 119) (i32.const 8))
    (call $fd_tell (local.get $fd) (i32.const 656)) drop
    (call $check (i32.wrap_i64 (i64.load (i32.const 656))) (i32.const 0) (i32.const 9))
    ;; 10-11: truncate to five bytes.
    (call $check (call $fd_filestat_set_size (local.get $fd) (i64.const 5)) (i32.const 0) (i32.const 10))
    (call $check (call $fd_filestat_get (local.get $fd) (i32.const 672)) (i32.const 0) (i32.const 11))
    (call $check (i32.wrap_i64 (i64.load (i32.const 704))) (i32.const 5) (i32.const 12))
    ;; 13-15: set both times (atim | mtim), read them back in nanoseconds.
    (call $check (call $fd_filestat_set_times (local.get $fd) (i64.const 100000000000) (i64.const 200000000000) (i32.const 5)) (i32.const 0) (i32.const 13))
    (call $check (call $fd_filestat_get (local.get $fd) (i32.const 672)) (i32.const 0) (i32.const 14))
    (call $check (i32.wrap_i64 (i64.div_u (i64.load (i32.const 712)) (i64.const 1000000000))) (i32.const 100) (i32.const 15))
    (call $check (i32.wrap_i64 (i64.div_u (i64.load (i32.const 720)) (i64.const 1000000000))) (i32.const 200) (i32.const 16))
    (call $check (call $fd_close (local.get $fd)) (i32.const 0) (i32.const 17))
    ;; 18-22: rename into a new directory, which cannot be removed while it has an entry.
    (call $check (call $path_create_directory (i32.const 3) (i32.const 520) (i32.const 1)) (i32.const 0) (i32.const 18))
    (call $check (call $path_rename (i32.const 3) (i32.const 512) (i32.const 5) (i32.const 3) (i32.const 528) (i32.const 7)) (i32.const 0) (i32.const 19))
    (call $check (call $path_filestat_get (i32.const 3) (i32.const 0) (i32.const 512) (i32.const 5) (i32.const 672)) (i32.const 44) (i32.const 20))
    (call $check (call $path_remove_directory (i32.const 3) (i32.const 520) (i32.const 1)) (i32.const 55) (i32.const 21))
    (call $check (call $path_unlink_file (i32.const 3) (i32.const 528) (i32.const 7)) (i32.const 0) (i32.const 22))
    (call $check (call $path_remove_directory (i32.const 3) (i32.const 520) (i32.const 1)) (i32.const 0) (i32.const 23))
    (global.get $failed))
)
